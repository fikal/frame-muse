{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FraimicMuse": {
    // Matches the bundled docker-compose.yml. Put YOUR real connection string in
    // appsettings.Local.json (gitignored) or the FraimicMuse__MongoConnectionString env var.
    "MongoConnectionString": "mongodb://framemuse:changeme@localhost:27017/?authSource=admin",
    "Database": "FraimicMuse",
    "FallbackJobSeconds": 300,
    // Optional: canonical URL (e.g. "https://frame.example.com"). Requests on any other host or
    // scheme are redirected there — useful once you set up HTTPS so voice input works. Leave empty
    // to serve on whatever host the request came in on.
    "CanonicalUrl": ""
  }
}
