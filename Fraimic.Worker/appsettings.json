{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "FraimicMuse": {
    // Matches the bundled docker-compose.yml. Put YOUR real connection string in
    // appsettings.Local.json (gitignored) or the FraimicMuse__MongoConnectionString env var.
    "MongoConnectionString": "mongodb://framemuse:changeme@localhost:27017/?authSource=admin",
    "Database": "FraimicMuse",
    "PollIntervalSeconds": 2,

    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "llama3.1:8b",
    "OllamaTemperature": 0.35,

    "ComfyUiBaseUrl": "http://localhost:8188",
    "ComfyWorkflowPath": "workflow.flux.json",
    "Img2ImgWorkflowPath": "workflow.flux.img2img.json",
    "Img2ImgDenoise": 0.72,
    "Img2ImgSteps": 8,
    "PulidWorkflowPath": "workflow.flux.pulid.json",
    // Face-identity strength. ReActor restores the real face afterward, so keep this LOW (~0.55)
    // to leave the prompt room for scene elements; 0.95+ collapses to a tight headshot.
    "PulidWeight": 0.55,
    "PulidSteps": 8,
    "PixelWorkflowPath": "workflow.sdxl.pixel.json",
    "GenerationTimeoutSeconds": 300,
    "GenerationWidth": 768,
    "GenerationHeight": 1344,

    "SafetyEnabled": true,
    "NsfwServiceUrl": "http://127.0.0.1:8190",

    // Extra brightness applied when encoding for the frame (1.0 = off). Reflective e-ink reads
    // darker than a screen; >1 brightens but skews warm colors toward the yellow pigment.
    "FrameBrightness": 1.0,

    // "fraimic.local" is the frame's default mDNS name; use its IP if mDNS is flaky on your LAN.
    "FrameHost": "fraimic.local",
    // "large" = 31.5" (1440x2560) | "standard" = 13.3" (1200x1600)
    "FrameModel": "large"
  }
}
